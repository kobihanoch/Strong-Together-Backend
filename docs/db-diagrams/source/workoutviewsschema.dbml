Table workout.v_exercise_to_workout_split_expanded [note: 'Security-invoker view'] {
  id bigint
  workout_split_id bigint
  workout_id bigint
  exercise_id bigint
  exercise text
  workout_split text
  reps integer
  order_index bigint
  set_index integer
  created_at timestamptz
  is_active boolean
}

Table workout.exercise_to_workout_split { id bigint [pk] }
Table workout.workout_split { id bigint [pk] }
Table workout.exercise { id bigint [pk] }
Table workout.workout_set { id uuid [pk] }

Ref: workout.v_exercise_to_workout_split_expanded.id > workout.exercise_to_workout_split.id
Ref: workout.v_exercise_to_workout_split_expanded.workout_split_id > workout.workout_split.id

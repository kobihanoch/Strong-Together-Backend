Table reminders.user_reminder_setting {
  user_id uuid [pk, ref: > identity.user.id]
  workout_reminders_enabled boolean [not null]
  reminder_offset_minutes integer [not null]
  updated_at timestamptz [not null]
  timezone text
}

Table reminders.user_split_information {
  id bigint [pk, increment]
  user_id uuid [not null, ref: > identity.user.id]
  workout_split_id bigint [not null, ref: > workout.workout_split.id]
  estimated_time_utc timestamptz [not null]
  confidence numeric(3,2) [not null]
  last_computed_at timestamptz [not null]
  preferred_weekday integer

  indexes { (user_id, workout_split_id) [unique] }
}

Table identity.user { id uuid [pk] }
Table workout.workout_split { id bigint [pk] }
